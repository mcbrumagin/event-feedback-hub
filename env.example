# Copy this file to .env and update values as needed

# API Configuration
JWT_SECRET=change-this-to-a-secure-secret-in-production
ADMIN_PASSWORD=admin123
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# CORS - comma-separated list of allowed origins
# For network/mobile testing, add your network IP:
CORS_ORIGIN=http://localhost:5173,http://192.168.0.10:5173

# Frontend Configuration (set these when running frontend)
# VITE_API_URL=http://192.168.0.10:4000

# Future: MongoDB Configuration
# MONGODB_URI=mongodb://admin:password@localhost:27017/event-feedback-hub?authSource=admin
